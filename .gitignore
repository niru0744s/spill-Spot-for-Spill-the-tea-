# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# ==========================================
# SECRETS & ENVIRONMENT VARIABLES
# ==========================================
.env
.env.*
!.env.example          # Keep the template — it has no real values

# ==========================================
# DEPENDENCIES
# ==========================================
node_modules/

# ==========================================
# EXPO
# ==========================================
.expo/
dist/
web-build/
expo-env.d.ts

# ==========================================
# NATIVE BUILDS
# ==========================================
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.pem

# Firebase native config files (contain project keys)
google-services.json
GoogleService-Info.plist

# Generated native folders (built by Expo EAS, not committed)
/ios
/android

# ==========================================
# FIREBASE
# ==========================================

# Local emulator data — machine-specific, can be huge
dataconnect/.dataconnect/

# Firebase local cache / temp files
.firebase/

# ==========================================
# AI AGENT SKILLS & LOCAL EDITOR CONFIG
# ==========================================

# Firebase Agent Skills — auto-downloaded by Firebase CLI,
# not source code. Each dev runs 'firebase init' to get them.
.agents/

# Claude AI editor config — local only
.CLAUDE.md
.GEMINI.md

# Agent skills lock file — regenerated by Firebase CLI
skills-lock.json

# ==========================================
# EXAMPLE / GENERATED BOILERPLATE
# ==========================================

# The 'example' connector was auto-created by firebase init — not our code
example/

# ==========================================
# METRO / DEBUG
# ==========================================
.metro-health-check*
npm-debug.*
yarn-debug.*
yarn-error.*

# ==========================================
# MISC
# ==========================================
.DS_Store
*.tsbuildinfo

# stitch designs 

stitchDesign

# Metro / Debug logs
firebase-debug.log

# Claude config directory
.claude/

# Firebase Service Account (secrets)
serviceAccountKey.json
backend/serviceAccountKey.json

